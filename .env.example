# Local demo only. Real campus SSO must be integrated before public deployment.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/yandu.db
AI_MODE=local
MATCH_THRESHOLD=0.82
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

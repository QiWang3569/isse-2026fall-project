# Local demo accounts are available only when true. Set false before inviting users.
DEMO_MODE=true
# Production deployment sets APP_ENV=production and SESSION_COOKIE_SECURE=true.
APP_ENV=local
SESSION_COOKIE_SECURE=false
# Email login accepts exactly @pku.edu.cn and @stu.pku.edu.cn.
# Set a random 32+ character secret and configure a TLS-enabled SMTP service.
AUTH_CODE_SECRET=
SMTP_HOST=
# PKU staff/older student mail: 465; stu.pku.edu.cn mail: 994 (both SSL).
SMTP_PORT=465
# For stu.pku.edu.cn SMTP, use the full sender email address as the login name.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Messages are deleted after this many days unless still needed for a chat report.
CHAT_RETENTION_DAYS=180
# Optional unread chat reminders. Uses the same TLS SMTP account as email login.
# Each registered user must also enable reminders in their profile.
CHAT_EMAIL_ENABLED=false
# Canonical site origin used in email links; production must match ALLOWED_ORIGINS.
PUBLIC_APP_URL=
CHAT_EMAIL_DELAY_SECONDS=300
CHAT_EMAIL_COOLDOWN_SECONDS=1800
# Set this before running docker compose; keep it the same in DATABASE_URL below.
POSTGRES_PASSWORD=
BACKUP_RETENTION_DAYS=14
# Public deployment: set SITE_DOMAIN to the real hostname, without https://.
SITE_DOMAIN=
# SQLite remains available for a zero-dependency local demo. See docs/POSTGRESQL.md
# for the PostgreSQL + pgvector setup and migration steps.
DATABASE_URL=sqlite:///./data/yandu.db
# local: no model calls. remote: parse and review with the chat model.
AI_MODE=local
# Independent: local works with a single chat API key; remote needs embedding credentials.
EMBEDDING_MODE=local
MODEL_TIMEOUT_SECONDS=20
MATCH_MAX_ATTEMPTS=3
MATCH_THRESHOLD=0.82
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional for providers supporting the thinking parameter (e.g. Qiniu Qwen):
# MODEL_THINKING=disabled
# Optional image-assisted publishing, independently configured from text AI.
VISION_ENABLED=false
VISION_API_KEY=
VISION_BASE_URL=https://api.qnaigc.com/v1
VISION_MODEL=qwen/qwen3.7-flash
VISION_THINKING=disabled
VISION_TIMEOUT_SECONDS=30
VISION_HOURLY_LIMIT=20
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
